generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPER_ADMIN
  EDITOR
  PROFESSOR
  ASSISTANT
  STUDENT
}

enum CourseMemberRole {
  PROFESSOR
  ASSISTANT
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

enum MaterialKind {
  LECTURE
  EXERCISE
  LAB
  EXAM
  OTHER
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique @db.VarChar(191)
  passwordHash  String             @db.VarChar(255)
  name          String             @db.VarChar(120)
  role          Role               @default(STUDENT)
  active        Boolean            @default(true)
  sessionVersion Int               @default(0)
  createdAt     DateTime           @default(now())
  memberships   CourseMembership[]
  news          News[]
  auditEntries  AuditLog[]
}

model News {
  id          String     @id @default(cuid())
  slug        String     @unique @db.VarChar(191)
  title       String     @db.VarChar(180)
  summary     String     @db.VarChar(300)
  body        String     @db.LongText
  status      NewsStatus @default(DRAFT)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
}

model Course {
  id          String             @id @default(cuid())
  slug        String             @unique @db.VarChar(191)
  code        String             @unique @db.VarChar(30)
  title       String             @db.VarChar(180)
  description String             @db.Text
  semester    Int
  studyLevel  String             @db.VarChar(60)
  createdAt   DateTime           @default(now())
  memberships CourseMembership[]
  materials   Material[]

  @@index([semester, title])
}

model CourseMembership {
  userId    String
  courseId  String
  role      CourseMemberRole
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@index([courseId])
}

model Material {
  id        String   @id @default(cuid())
  courseId  String
  title     String       @db.VarChar(180)
  url       String       @db.VarChar(1500)
  kind      MaterialKind @default(OTHER)
  createdAt DateTime     @default(now())
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@index([courseId, kind, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String   @db.VarChar(70)
  subjectType String   @db.VarChar(40)
  subjectId   String   @db.VarChar(191)
  occurredAt  DateTime @default(now())
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([subjectType, subjectId])
}

/// The key is an HMAC of the normalized email, never plain email.
model LoginThrottle {
  key       String   @id @db.VarChar(64)
  failures  Int      @default(0)
  resetAt   DateTime
}
