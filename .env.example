# MySQL connection URL (used by Prisma migrations)
DATABASE_URL="mysql://eepsi:change-me@127.0.0.1:3306/eepsi"
# Driver adapter connection settings (runtime)
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3306"
DATABASE_USER="eepsi"
DATABASE_PASSWORD="change-me"
DATABASE_NAME="eepsi"

# Generate: openssl rand -base64 48
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Only used by npm run db:seed; never put a real password in Git
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="Administrator"
