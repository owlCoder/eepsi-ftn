{
  "name": "eepsi-ftn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test:integration": "vitest run tests/integration",
    "db:cleanup-throttles": "tsx scripts/cleanup-throttles.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "next-auth": "4.24.15",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-mariadb": "7.10.1",
    "mariadb": "^3.4.0",
    "bcryptjs": "3.0.3",
    "lucide-react": "1.68.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.4",
    "@tailwindcss/postcss": "4.3.4",
    "postcss": "8.5.32",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "vitest": "5.1.0",
    "tsx": "^4.20.0",
    "dotenv": "18.0.9"
  }
}
